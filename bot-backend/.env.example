# ===========================================
# Polymarket Trading Bot Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Test Mode ---
# Set to "true" to run without a real wallet or Polymarket connection.
# Simulates trades with fake prices, realistic latency, and P&L tracking.
TEST_MODE=false

# --- Platform Selection ---
# "kalshi"         — Kalshi (CFTC-regulated US prediction market, recommended)
# "polymarket-us"  — Polymarket US (US-legal, requires iOS KYC + Ed25519 keys below)
# "polymarket"     — Original Polymarket CLOB (non-US only)
PLATFORM=kalshi

# --- Kalshi API (PLATFORM=kalshi) ---
# Generate at kalshi.com → Account → API Keys → Create key.
# Download the RSA private key PEM file and copy the Key ID here.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY=

# --- Polymarket US API ---
# Generate these at polymarket.us/developer after completing KYC in the iOS app.
# The secret key is shown only once — store it securely.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# --- Wallet (Original Polymarket CLOB only — not needed for Polymarket US) ---
# Your Ethereum private key (with 0x prefix)
# This wallet must have USDC on Polygon and have approved
# the Polymarket CTF Exchange contract for USDC spending.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# --- Polymarket CLOB API (not needed for Polymarket US) ---
# Leave blank on first run — the bot will generate keys
# and print them to the console. Then paste them here.
CLOB_API_URL=https://clob.polymarket.com
CHAIN_ID=137
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# --- WebSocket Server ---
WS_PORT=8080

# --- Trading Defaults ---
# USDC amount to spend per buy signal
DEFAULT_BUY_SIZE=10
# Maximum price (0-1) to pay per contract. Prevents buying at unfavorable odds.
MAX_PRICE=0.95

# --- Logging ---
# Set to "debug" for verbose output
LOG_LEVEL=info
